# Copie para .env e preencha. NUNCA commite o .env preenchido.

# Ambiente de execução: "production" ativa o modo produção
NODE_ENV=
# Porta do servidor HTTP (padrão 3000)
PORT=
# Origem pública do site, usada em links de e-mail e redirects
FRONTEND_URL=

# Banco de dados
# String de conexão MySQL (mysql://usuario:senha@host:porta/banco)
DATABASE_URL=
# Banco DESCARTÁVEL para o teste de integração (pnpm test). A suíte nunca lê
# DATABASE_URL; sem esta variável o teste de integração se pula.
DATABASE_URL_TESTES=

# Autenticação
# Identificador do app gravado no JWT de sessão (claim appId)
VITE_APP_ID=
# Segredo de assinatura dos cookies/JWT
JWT_SECRET=

# Criptografia
# Chave do cofre de credenciais; sem ela cai no JWT_SECRET
VAULT_ENCRYPTION_KEY=

# LLM
# Endpoint compatível com a API da OpenAI. Para o Google Gemini:
# https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_URL=
# Chave do endpoint acima; GOOGLE_API_KEY serve de alternativa
LLM_API_KEY=
GOOGLE_API_KEY=

# Storage de arquivos (uploads, gravações de reunião, documentos)
# API do S3, que é padrão de fato: AWS S3, Cloudflare R2, Backblaze B2 e MinIO
# servem — a decisão D6 escolhe o provedor, o código é o mesmo.
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Só para provedor que não seja a AWS (ex.: https://<conta>.r2.cloudflarestorage.com)
STORAGE_ENDPOINT=
# Padrão: "auto" com STORAGE_ENDPOINT definido; "us-east-1" na AWS
STORAGE_REGION=

# Sobrescreve o modelo padrão das chamadas de texto (gemini-3.5-flash), que vão
# ao LLM_API_URL. Id concreto, com número de versão: alias (-latest, gemini-pro)
# é recusado, com aviso no log, e o padrão assume. Id de outro provedor
# compatível com a OpenAI passa (gpt-4o-2024-08-06, por exemplo).
LLM_MODEL=

# Modelo da TRANSCRIÇÃO (opcional). Padrão: gemini-3.5-flash. A transcrição vai
# sempre à API do Gemini: só vale id do Gemini no formato gemini-<versão>, nunca
# alias. Os ids que a chave enxerga saem de node scripts/listar-modelos-gemini.mjs.
LLM_AUDIO_MODEL=

# Modelo reserva da TRANSCRIÇÃO (opcional). Assume quando o modelo de áudio
# principal está lotado (503) ou com a cota do dia esgotada (429). Padrão:
# gemini-3.5-flash-lite — concreto (nunca alias -latest), diferente do
# principal e com aceite de áudio conferido nos docs do Gemini.
LLM_AUDIO_MODEL_RESERVA=

# E-mail
# Chave da API Resend
RESEND_API_KEY=
# Remetente dos e-mails transacionais ("Nome <endereco>")
EMAIL_FROM=

# Testes
# "true" libera os testes que chamam os provedores reais
RUN_LIVE_CREDENTIAL_TESTS=

# Exame de produção
# O exame de produção (scripts/checar-producao.mjs) lê um .env.producao separado,
# ignorado pelo git como todo .env.*, com DATABASE_URL do banco de produção
# Opcional: URL do site examinado (padrão https://mmm-gud5.onrender.com)
EXAME_BASE_URL=
