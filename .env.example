# Copie para .env e preencha. NUNCA commite o .env preenchido.

# Ambiente de execução: "production" ativa o modo produção
NODE_ENV=
# Porta do servidor HTTP (padrão 3000)
PORT=
# Origem pública do site, usada em links de e-mail e redirects
FRONTEND_URL=

# Banco de dados
# String de conexão MySQL (mysql://usuario:senha@host:porta/banco)
DATABASE_URL=
# Banco DESCARTÁVEL para o teste de integração (pnpm test). A suíte nunca lê
# DATABASE_URL; sem esta variável o teste de integração se pula.
DATABASE_URL_TESTES=

# Autenticação
# Identificador do app gravado no JWT de sessão (claim appId)
VITE_APP_ID=
# Segredo de assinatura dos cookies/JWT
JWT_SECRET=

# Criptografia
# Chave do cofre de credenciais; sem ela cai no JWT_SECRET
VAULT_ENCRYPTION_KEY=
# A base das associações (N1): HMAC do CNPJ dos associados, para achar repetidos sem
# guardar o número em claro. 32 caracteres ou mais (openssl rand -base64 48). Sem ela,
# ou sem a VAULT_ENCRYPTION_KEY com 32 ou mais, a importação e a lista das entidades recusam.
# Nunca troque depois da primeira carga: os repetidos deixariam de ser achados.
ENTIDADES_HMAC_KEY=

# LLM
# Endpoint compatível com a API da OpenAI. Para o Google Gemini:
# https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_URL=
# Chave do endpoint acima; GOOGLE_API_KEY serve de alternativa
LLM_API_KEY=
GOOGLE_API_KEY=

# Storage de arquivos (uploads, gravações de reunião, documentos)
# API do S3, que é padrão de fato: AWS S3, Cloudflare R2, Backblaze B2 e MinIO
# servem — a decisão D6 escolhe o provedor, o código é o mesmo.
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Só para provedor que não seja a AWS (ex.: https://<conta>.r2.cloudflarestorage.com)
STORAGE_ENDPOINT=
# Padrão: "auto" com STORAGE_ENDPOINT definido; "us-east-1" na AWS
STORAGE_REGION=

# Sobrescreve o modelo padrão das chamadas de texto (gemini-3.5-flash), que vão
# ao LLM_API_URL. Id concreto, com número de versão: alias (-latest, gemini-pro)
# é recusado, com aviso no log, e o padrão assume. Id de outro provedor
# compatível com a OpenAI passa (gpt-4o-2024-08-06, por exemplo).
LLM_MODEL=

# Modelo de texto por função (opcionais), com a mesma guarda do LLM_MODEL. A
# ordem: a variável da função > o padrão da função no código > LLM_MODEL > o
# padrão. Hoje nenhuma função tem padrão no código: a extração da reunião, o
# resumo guardado e o Pergunte à reunião seguem o LLM_MODEL. Antes de pôr o
# Lite na extração, leia docs/deploy.md: ele não devolve todas as entidades.
LLM_MODEL_EXTRACAO=
LLM_MODEL_RESUMO=
LLM_MODEL_PERGUNTA=
# "A IA escolhe o modelo" do resumo (H4e): sem valor, o gemini-3.5-flash-lite
# quando o texto vai à API do Gemini; fora dela, o LLM_MODEL.
LLM_MODEL_ESCOLHA_DO_MODELO=

# Critério semântico ESTREITO do motor privado de match (N7, opcional). Vazio =
# desligado, o padrão: nenhum texto da agenda vai ao provedor de embeddings.
# "1" liga; antes de ligar em produção, publique a versão nova do termo do Smart
# Match (docs/termos/termo-smart-match.md) e calibre o limiar (docs/medir-o-match.md).
MATCH_SEMANTICO_ESTREITO=

# Modelo da TRANSCRIÇÃO (opcional). Padrão: gemini-3.5-flash. A transcrição vai
# sempre à API do Gemini: só vale id do Gemini no formato gemini-<versão>, nunca
# alias. Os ids que a chave enxerga saem de node scripts/listar-modelos-gemini.mjs.
LLM_AUDIO_MODEL=

# Modelo reserva da TRANSCRIÇÃO (opcional). Assume quando o modelo de áudio
# principal está lotado (503) ou com a cota do dia esgotada (429). Padrão:
# gemini-3.5-flash-lite — concreto (nunca alias -latest), diferente do
# principal e com aceite de áudio conferido nos docs do Gemini.
LLM_AUDIO_MODEL_RESERVA=

# Voz do Gemini do "Baixar o áudio do resumo" (opcional). Padrão:
# gemini-3.8-flash-lite-tts. A mesma guarda do LLM_AUDIO_MODEL (gemini-<versão>).
LLM_TTS_MODEL=

# Modelo da busca na web do complemento de um item do resumo (opcional; a
# ferramenta google_search só existe na API do Gemini). Padrão: o do texto,
# gemini-3.5-flash. A mesma guarda do LLM_AUDIO_MODEL.
LLM_MODEL_BUSCA=

# E-mail
# Chave da API Resend
RESEND_API_KEY=
# Remetente dos e-mails transacionais ("Nome <endereco>")
EMAIL_FROM=

# Testes
# "true" libera os testes que chamam os provedores reais
RUN_LIVE_CREDENTIAL_TESTS=

# Exame de produção
# O exame de produção (scripts/checar-producao.mjs) lê um .env.producao separado,
# ignorado pelo git como todo .env.*, com DATABASE_URL do banco de produção
# Opcional: URL do site examinado (padrão https://mmm-gud5.onrender.com)
EXAME_BASE_URL=

# Chaves de acesso: entrar com Face ID ou digital (server/chaves-de-acesso.ts)
# O domínio a que as chaves ficam presas (RP ID). Em produção: wrwglobal.org.
# Depois da primeira chave cadastrada ele não muda mais: trocar invalida todas.
WEBAUTHN_RP_ID=
# As origens que podem usar as chaves, separadas por vírgula. Em produção:
# https://wrwglobal.org,https://www.wrwglobal.org. Sem as duas variáveis, ou
# num endereço fora da lista (o .onrender.com, por exemplo), a função não
# aparece. No desenvolvimento: WEBAUTHN_RP_ID=localhost e
# WEBAUTHN_ORIGENS=http://localhost:3000.
WEBAUTHN_ORIGENS=

# Sala de vídeo da reunião (V1, server/sala-de-video.ts e server/daily.ts)
# A chave da API do Daily e o subdomínio da conta lá ("marquesa" ou
# "marquesa.daily.co"). As duas vão juntas: sem elas, a sala some da tela.
DAILY_API_KEY=
DAILY_DOMINIO=
# O segredo (base64) que o Daily usa para assinar os avisos de quem entrou e
# saiu, passado como "hmac" ao criar o webhook. Opcional: sem ele, a rota dos
# avisos dá 404 e o orçamento conta cada sala pelo teto (8 pessoas x 120 min).
DAILY_WEBHOOK_SEGREDO=
