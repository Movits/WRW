{
  "expo": {
    "name": "WRW",
    "slug": "wrw",
    "owner": "marquesa-match",
    "scheme": "wrw",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "org.wrwglobal.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "A WRW usa o microfone para gravar as suas reuniões e ditados, só quando você toca em gravar.",
        "NSCameraUsageDescription": "A WRW usa a câmera quando você escolhe Tirar Foto, para fotografar um contato, um cartão de visita ou um texto.",
        "NSPhotoLibraryUsageDescription": "A WRW abre as suas fotos quando você escolhe uma imagem para enviar, como a foto de um contato ou um cartão de visita.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.wrwglobal.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.MODIFY_AUDIO_SETTINGS"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#b87a5e",
          "defaultChannel": "avisos"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "84ab79e3-08ce-4442-842a-85d333421de6"
      }
    }
  }
}
