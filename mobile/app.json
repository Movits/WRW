{
  "expo": {
    "name": "WRW",
    "slug": "wrw",
    "scheme": "wrw",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "org.wrwglobal.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "A WRW usa o microfone para gravar as suas reuniões e ditados, só quando você toca em gravar.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.wrwglobal.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "A WRW usa o Face ID para abrir o app com segurança, só se você ligar essa opção."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "84ab79e3-08ce-4442-842a-85d333421de6"
      }
    },
    "owner": "nicolas240767"
  }
}
